# Variables d'environnement pour Docker Compose
# Copiez ce fichier en .env et adaptez les valeurs

# Compte admin PocketBase (premier démarrage uniquement)
PB_ADMIN_EMAIL=admin@repertoryhub.local
PB_ADMIN_PASSWORD=changeme_secure_password

# URL PocketBase (pour Nuxt en production Docker)
NUXT_PUBLIC_POCKETBASE_URL=http://localhost:8090
